    "@launchpilot/domain": "workspace:*",
    "@launchpilot/ports": "workspace:*",
    "tsx": "4.20.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@launchpilot/testing": "workspace:*",
    "@types/node": "22.20.5",
    "vitest": "3.2.7"
  }
