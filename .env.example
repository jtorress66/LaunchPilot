# Copy to .env and adjust. Never commit real credentials.
DATABASE_URL=postgres://launchpilot:launchpilot@localhost:5432/launchpilot
APP_URL=http://localhost:3000
# development | test | production (default). Local billing is refused in production.
APP_ENV=development
# local: in-app test checkout (no payment provider). stripe: real Stripe (test or live keys).
BILLING_PROVIDER=local
LOCAL_BILLING_SECRET=change-me-to-a-long-random-string
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# claude: Claude drafts the Product Brief (needs ANTHROPIC_API_KEY).
# extractive: offline drafter that quotes your site (development and test only).
BRIEF_DRAFTER=extractive
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5
# claude: Claude writes SEO articles. template: offline writer (development and test only).
ARTICLE_WRITER=template
# dataforseo: real keyword data (needs DATAFORSEO_LOGIN/PASSWORD). offline: made-up data (dev/test only).
KEYWORD_PROVIDER=offline
# DATAFORSEO_LOGIN=you@example.com
# DATAFORSEO_PASSWORD=...
# Encrypts blog passwords at rest. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# true lets the crawler and publishers reach localhost or your LAN (development and test only).
ALLOW_PRIVATE_NETWORK=false
APP_VERSION=0.1.0
HEARTBEAT_INTERVAL_MS=60000
