{
  "name": "launchpilot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @launchpilot/web --filter @launchpilot/worker dev",
    "build": "pnpm --filter @launchpilot/web build",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:int": "vitest run --config vitest.int.config.ts --coverage",
    "test:e2e": "node scripts/e2e.mjs",
    "eval": "node scripts/eval.mjs",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "pnpm --filter @launchpilot/worker migrate",
    "stripe:setup": "pnpm --filter @launchpilot/worker stripe:setup",
    "test:e2e:stripe": "playwright test --config playwright.stripe.config.ts",
    "smoke:keywords": "pnpm --filter @launchpilot/worker smoke:keywords",
    "smoke:social": "pnpm --filter @launchpilot/worker smoke:social"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "15.5.27",
    "@playwright/test": "1.56.1",
    "@testcontainers/postgresql": "11.14.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "3.2.7",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "prettier": "3.9.10",
    "testcontainers": "11.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
